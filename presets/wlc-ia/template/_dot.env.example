# Copie para .env e preencha. Este arquivo NUNCA deve conter valores reais.
# Lido apenas pelo servidor (server/index.mjs) — nunca chega ao navegador.

# Chave do provedor de IA compatível com a API OpenAI (obrigatória para respostas reais)
AI_API_KEY=

# Endereço base do provedor (opcional; padrão: https://api.openai.com/v1)
AI_BASE_URL=https://api.openai.com/v1

# Modelo usado nas respostas (opcional; padrão: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# Porta do servidor de IA (opcional; padrão: 8787)
PORT=8787
